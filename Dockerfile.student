# Dockerfile.student — Unified Single-Container Production Image for Azure for Students (Free Tier)
# Serves React Web SPA + Express REST API + /ws WebSockets + Auto-Migrations from port 8080

FROM node:22-alpine AS web-builder
WORKDIR /build/web
COPY apps/web/package.json ./
RUN npm install
COPY apps/web/tsconfig.json apps/web/vite.config.ts apps/web/index.html ./
COPY apps/web/src ./src
RUN npm run build

FROM node:22-alpine AS api-builder
WORKDIR /build/api
COPY services/api/package*.json ./
RUN npm ci
COPY services/api/tsconfig.json ./
COPY services/api/src ./src
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV AUTO_MIGRATE=true
ENV STATIC_WEB_DIR=/app/public
ENV MIGRATIONS_DIR=/app/db/migrations
ENV SEEDS_DIR=/app/db/seeds

COPY services/api/package*.json ./
RUN npm ci --omit=dev
COPY --from=api-builder /build/api/dist ./dist
COPY --from=web-builder /build/web/dist ./public
COPY db ./db

EXPOSE 8080
USER node
CMD ["node", "dist/index.js"]
